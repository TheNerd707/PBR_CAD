<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
    <link
      href="https://fonts.cdnfonts.com/css/verdana-pro-cond"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="header">
      <img src="/public/files/smallLogoBlack.png" class="logo" />
      <div class="discord">Discord</div>
      <div class="about">About</div>
      <img
        src="/public/files/images__1_-removebg-preview.png"
        class="about-icon"
      />
    </div>
    <div class="wb">Weclome Back,</div>
    <div class="name"><%= name %>!</div>
    <div class="line"></div>
    <div class="my">My Communities</div>
    <div class="line"></div>
    <% userGuilds.forEach(guild => { %>
    <a
      href="/main?guildId=<%= guild.code %>"
      style="text-decoration: none"
      class="container"
    >
      <div class="gName"><%= guild.name %></div>
      <div class="play">Play</div></a
    >
    <% }) %>
    <div class="new-container">
      <a href="" class="join" style="text-decoration: none; color: black"
        >Join New +</a
      >
      <a href="" class="create" style="text-decoration: none; color: black"
        >Create New +</a
      >
    </div>
    <div class="message">
      <% if (typeof message !== 'undefined') { %>
        <p><%= message %></p>
      <% } %>
    </div>
    <div class="joinNew">
      <form action="/guild-join" method="post">
        <label for="id">Ready for a new journey?</label><br />
        <input
          type="text"
          name="id"
          id="id"
          placeholder="  enter community code"
          required
        /><br />
        <div class="newLine"></div>
        <button type="submit" class="joinButton">Submit</button>
        <div class="Cancel">Cancel</div>
      </form>
    </div>
  </body>
  <style>
    html {
      padding: 0;
      margin: 0;
      font-family: "Verdana Pro", sans-serif;
    }
    body {
      height: 200vh;
      margin: 0;
      padding: 0;
      background-color: #14425a;
      color: white;
      font-family: "Verdana Pro", sans-serif;
    }
    .header {
      position: absolute;
      width: 100%;
      height: 2.25vw;
      background-color: black;
    }
    .logo {
      position: absolute;
      left: 0.01vw;
      width: 2.2vw;
      height: relative;
      top: 50%;
      transform: translateY(-50%);
    }
    .discord {
      position: absolute;
      right: 5.25vw;
      font-size: 1vw;
      color: white;
      top: 50%;
      transform: translateY(-50%);
    }
    .about {
      position: absolute;
      right: 1.3vw;
      font-size: 1vw;
      color: white;
      top: 50%;
      transform: translateY(-50%);
    }
    .about-icon {
      position: absolute;
      right: 0.1vw;
      width: 1.1vw;
      height: 1.1vw;
      top: 59%;
      transform: translateY(-50%);
    }
    .wb {
      position: relative;
      top: 7vw;
      left: 50%;
      transform: translate(-50%, -50%);
      text-align: center;
      font-size: 3vw;
      font-weight: bold;
    }
    .name {
      position: relative;
      top: 7vw;
      left: 50%;
      transform: translate(-50%, -50%);
      text-align: center;
      font-size: 3vw;
      font-weight: bold;
    }
    .line {
      position: relative;
      top: 7vw;
      left: 50%;
      transform: translateX(-50%);
      width: 40vw;
      height: 0.05vw;
      background-color: white;
    }
    .todo {
      position: relative;
      height: 4.25vw;
      top: 7.925vw;
      align-self: center;
      left: 50%;
      transform: translateX(-50%);
      text-align: center;
      font-size: 1.5vw;
    }
    .my {
      position: relative;
      top: 7vw;
      left: 50%;
      transform: translateX(-50%);
      font-size: 1.7vw;
      text-align: center;
      color: white;
    
      width: 17vw;
      height: 4.25vw;
      border-radius: 0.25vw;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: bold;
    }
    .container {
      position: relative;
      top: 9vw;
      left: 50%;
      transform: translateX(-50%);
      width: 45vw;
      height: 2.75vw;
      background-color: #0a212d;
      border-radius: 0.25vw;
      margin-top: 0.5vw;
      font-family: "Verdana Pro", sans-serif;
      font-weight: bold;
      color: white;
      cursor: default;
      text-decoration: none;
      display: block;
    }
    .gName {
      position: relative;
      top: 50%;
      left: 1vw;
      transform: translateY(-50%);
      font-size: 1.25vw;
    }
    .play {
      position: absolute;
      right: 1vw;
      width: 5vw;
      top: 50%;
      transform: translateY(-50%);
      height: 1.75vw;
      background-color: #14425a;
      border-radius: 0.25vw;
      font-size: 1vw;
      text-align: center;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
    }
    .new-container {
      position: relative;
      top: 10vw;
      left: 50%;
      transform: translateX(-50%);
      width: 45vw;
      height: 2.75vw;
      border-radius: 0.25vw;
      margin-top: 0.5vw;
      font-family: "Verdana Pro", sans-serif;
      font-weight: bold;
      color: black;
      font-size: 1vw;
    }
    .join {
      position: absolute;
      top: 50%;
      left: 0;
      transform: translateY(-50%);
      width: 8vw;
      height: 2.75vw;
      background-color: white;
      border-radius: 0.25vw;
      text-align: center;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
    }
    .create {
      position: absolute;
      top: 50%;
      right: 0;
      transform: translateY(-50%);
      width: 9vw;
      height: 2.75vw;
      background-color: white;
      border-radius: 0.25vw;
      text-align: center;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
    }
    .joinNew {
      transition: 0.3s;
      position: fixed;
      top: 50%;
      left: -50%;
      transform: translateX(-50%) translateY(-50%);
      width: 45vw;
      height: 20vw;
      background-color: black;
      border-radius: 0.5vw;
      display: flex;
      flex-direction: column;
      align-items: center;
      opacity: 95%;
    }
    .joinNew form {
      display: flex;
      flex-direction: column;
      align-items: center;
    }
    .joinNew label {
      position: absolute;
      text-align: center;
      top: 2dvh;
      width: 60%;
      font-size: 2vw;
      color: white;
      font-weight: bold;
    }
    .joinNew input {
      position: absolute;
      width: 90%;
      height: 2vw;
      border-radius: 0.25vw;
      padding: 0.5vw;
      font-size: 1.5vw;
      top: 40%;
      background-color: #0a212d;
      box-shadow: none;
      color:white;
      border: none;
      outline: none;
    }
    .newLine {
      position: absolute;
      width: 89%;
      height: 0.5%;
      background-color: white;
      opacity: 100%;
      top: 52.6%;
    }
    .joinButton {
      position: absolute;
      width: 10vw;
      height: 2.5vw;
      background-color: #14425a;
      border-radius: 0.25vw;
      font-size: 1.5vw;
      color: white;
      border: none;
      cursor: pointer;
      top: 70%;
    }
    .Cancel {
      position: absolute;
      font-size: 1.5vw;
      color: white;
      background-color: black;
      cursor: pointer;
      top: 85%;
      border: none;
      opacity: 95%;
    }
    .Cancel:hover {
      text-decoration: underline;
    }
    .message {
      position: absolute;
      top: 90%;
      left: 50%;
      transform: translateX(-50%);
      width: 40vw;
      text-align: center;
      font-size: 1.5vw;
      color: white;
    }
  </style>
  <script>
    const joinNew = document.querySelector('.joinNew');
    const joinButton = document.querySelector('.join');
    const cancelButton = document.querySelector('.Cancel');

    joinButton.addEventListener('click', (e) => {
      e.preventDefault();
      joinNew.style.left = '50%';
    });
    cancelButton.addEventListener('click', (e) => {
      e.preventDefault();
      joinNew.style.left = '150%';
      setTimeout(() => {
        joinNew.style.top = '-100%';
      }, 300);
      setTimeout(() => {
        joinNew.style.left = '-50%';
      }, 600);
      setTimeout(() => {
        joinNew.style.top = '50%';
      }, 900);
    });
  </script>
</html>
