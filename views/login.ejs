<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login</title>
    <link
      href="https://fonts.cdnfonts.com/css/verdana-pro-cond"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="header">
      <img src="/public/files/smallLogoBlack.png" class="logo" />
      <div class="discord">Discord</div>
      <div class="about">About</div>
      <img src="/public/files/images__1_-removebg-preview.png" class="about-icon">
    </div>
    <div class="login">Login</div>
    <div class="container">
      <form action="/login" method="post">
        <input
          type="text"
          name="user"
          id="user"
          class="user"
          value="<%= typeof user !== 'undefined' ? user : '' %>"
          placeholder="Username"
          required
        /><br />
        <input
          type="password"
          name="password"
          id="password"
          class="password"
          placeholder="Password"
          required
        /><br />
        <button type="submit" class="submit">Continue</button>
      </form>
    </div>
    <a href="/signup" class="signup">Don't have an account?</a>
    <div class="line"></div>
    <a href="/" class="back">Back to home.</a>
    <div class="message"><%= message %></div>

  </body>
  <style>
    html {
      padding: 0;
      margin: 0;
      font-family: "Verdana Pro", sans-serif;
    }
    body {
      margin: 0;
      padding: 0;
      background-color: #14425a;
      font-family: "Verdana Pro", sans-serif;
    }
    .header {
      position: absolute;
      width: 100%;
      height: 2.25vw;
      background-color: black;
    }
    .logo {
      position: absolute;
      left: 0.01vw;
      width: 2.2vw;
      height: relative;
      top: 50%;
      transform: translateY(-50%);
    }
    .discord {
      position: absolute;
      right: 5.25vw;
      font-size: 1vw;
      color: white;
      top: 50%;
      transform: translateY(-50%);
    }
    .about {
      position: absolute;
      right: 1.3vw;
      font-size: 1vw;
      color: white;
      top: 50%;
      transform: translateY(-50%);
    }
    .about-icon {
      position: absolute;
      right: 0.1vw;
      width: 1.1vw;
      height: 1.1vw;
      top: 59%;
      transform: translateY(-50%);
    }
    .login {
      position: absolute;
      top: 5vw;
      left: 50%;
      transform: translateX(-50%);
      font-size: 3vw;
      font-weight: bold;
      color: white;
      z-index: 1;
    }
    .container {
      position: absolute;
      top: 10vw;
      left: 50%;
      width: 40vw;
      height: 17vw;
      transform: translateX(-50%);
      background-color: #0A212D;
      border-radius: 0.5vw;
      font-size: 2vw;
    }
    .user {
      position: absolute;
      top: 1vw;
      left: 1vw;
      width: 37.5vw;
      height: 4vw;
      background-color: #07161e;
      text-indent: 0.5vw;
      color: white;
      border: none;
      border-radius: 0.25vw;
      border-bottom: 1px solid white;
      font-size: 1.6vw;
    }
    .user:focus, .user:active {
      background-color: #07161e;
      color: white;
    }
    .password {
      position: absolute;
      top: 7vw;
      left: 1vw;
      width: 37.5vw;
      height: 4vw;
      background-color: #07161e;
      color: white;
      border: none;
      text-indent: 0.5vw;
      border-radius: 0.25vw;
      border-bottom: 1px solid white;
      font-size: 1.6vw;
    }
    .password:focus, .password:active{
      background-color: #07161e;
    }
    .logo2 {
      position: relative;
      width: 7vw;
      height: 7vw;
      display: block;
      margin: 0 auto;
      top: 10vw;
      z-index: -1;
    }
    .submit {
      position: absolute;
      z-index: -2;
      top: 12.5vw;
      left: 14.5vw;
      width: 10vw;
      height: 3vw;
      cursor: pointer;
      background-color: #14425a;
      border-radius: 0.25vw;
      color: white;
      border: none;
      font-size: 1.5vw;
    }
    .signup {
      position: absolute;
      top: 28vw;
      left: 50%;
      transform: translateX(-50%);
      font-size: 1.3vw;
      color: white;
      text-decoration: none ;
      font-style: italic;
      font-family: "Verdana Pro", sans-serif;
    }
    .signup:hover {
      text-decoration: underline;
    }
    .line {
      position: absolute;
      top: 30.5vw;
      left: 50%;
      transform: translateX(-50%);
      width: 18vw;
      height: 0.1vw;
      background-color: white;
    }
    .back {
      position: absolute;
      top: 31.25vw;
      left: 50%;
      transform: translateX(-50%);
      font-size: 1.3vw;
      color: white;
      text-decoration: none ;
      font-style: italic;
      font-family: "Verdana Pro", sans-serif;
    }
    .back:hover {
      text-decoration: underline;
    }
    .message {
      position: absolute;
      top: 25vw;
      left: 50%;
      transform: translateX(-50%);
      font-size: 1.3vw;
      color: white;
    }
    input:-webkit-autofill,
    input:-webkit-autofill:hover,
    input:-webkit-autofill:focus,
    textarea:-webkit-autofill,
    textarea:-webkit-autofill:hover,
    textarea:-webkit-autofill:focus {
      background-color: #0A212D !important;
      -webkit-text-fill-color: white !important;
    }
  </style>
</html>
