<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>CAD</title>
    <link href="https://fonts.cdnfonts.com/css/verdana-pro-cond" rel="stylesheet">
  </head>
  <body>
    <div class="header">
        <img src="/public/files/smallLogoBlack.png" class="logo">
        <div class="discord">Discord</div>
        <div class="about">About </div>
    <img src="/public/files/images__1_-removebg-preview.png" class="about-icon">
    </div>
    <div class="wc">Welcome to</div>
    <img src="/public/files/cadNameLogo.png" class="cadNameLogo">
    <div class="buttons">
    <div class="button-selection">
      <div class="account">Already have an account?</div>
      <a href="/login"><button class="Sign-in">Sign-in</button></a>
    </div>
    <div class="line"></div>
    <div class="button-selection">
      <div class="account">Don't have an account?</div>
      <a href="/signup"><button class="Sign-up">Sign-up</button></a>
    </div>
  </div>
  </body>
  <style>
    html {
      padding: 0;
      margin: 0;
      font-family: 'Verdana Pro', sans-serif;
    }
    body{
        margin: 0;
        padding: 0;
        background-color: #14425A;
        font-family: 'Verdana Pro', sans-serif;
    }
    .header {
      position: absolute;
      width: 100%;
      height: 2.25vw;
      background-color: black;
    }
    .logo {
      position: absolute;
      left: 0.01vw;
      width: 2.2vw;
      height: relative;
      top: 50%;
      transform: translateY(-50%);
    }
    .discord {
      position: absolute;
      right: 5.25vw;
      font-size: 1vw;
      color: white;
      top: 50%;
      transform: translateY(-50%);
    }
    .about {
      position: absolute;
      right: 1.3vw;
      font-size: 1vw;
      color: white;
      top: 50%;
      transform: translateY(-50%);
    }
    .about-icon {
      position: absolute;
      right: 0.1vw;
      width: 1.1vw;
      height: 1.1vw;
      top: 59%;
      transform: translateY(-50%);
    }
    .wc {
        position: absolute;
        top: 7vw;
        font-size: 4vw;
        font-weight: bold;
        width: 100%;
        text-align: center;
        height: 1.7vw;
        color: white;
        
    }
    .cadNameLogo {
        position: absolute;
        display: block;
        top: 20vw;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 40vw;
        height: 40vw;
        z-index: -1;
    }
    .buttons {
        position: absolute;
        top: 30vw;
        width: 100%;
        font-size: 1.5vw;
        display: flex;
        justify-content: center;
        align-items: center;
        color: white;
    }
    .button-selection {
        display: flex;
        flex-direction: column;
        align-items: center;
        margin: 0 2vw;
        font-family: 'Verdana Pro', sans-serif;
    }
    .buttons button {
        width: 10vw;
        height: 3vw;
        background-color: black;
        color: white;
        margin-top: 1vw;
        font-size: 1.5vw;
        cursor: pointer;
    }
    .line {
        width: 0.15vw;
        height: 5vw;
        background-color: white;
    }
  </style>
</html>
