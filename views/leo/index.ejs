<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>LEO</title>
    <style>
      html,
      body {
        margin: 0;
        padding: 0;
        font-family: "Verdana Pro", sans-serif;
        background-color: black;
      }

      .header {
        position: absolute;
        width: 100%;
        height: 2.25vw;
        background-color: #14425a;
      }

      .logo {
        position: absolute;
        left: 0.01vw;
        width: 2.2vw;
        top: 50%;
        transform: translateY(-50%);
      }

      .about {
        position: absolute;
        right: 1.3vw;
        font-size: 1vw;
        color: white;
        top: 50%;
        transform: translateY(-50%);
      }

      .about-icon {
        position: absolute;
        right: 0.1vw;
        width: 1.1vw;
        height: 1.1vw;
        top: 59%;
        transform: translateY(-50%);
      }

      .container {
        position: absolute;
        top: 5vw;
        width: 100%;
        display: flex;
        justify-content: center;
        gap: 1vw;
      }

      .database,
      .notepad,
      .map,
      .resources {
        width: 15vw;
        height: 4vw;
        background-color: #14425a;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2vw;
        font-weight: bold;
        cursor: pointer;
      }

      .status {
        position: absolute;
        top: 11vw;
        width: 100%;
        height: 5vw;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2vw;
        font-weight: bold;
      }

      .custom-select {
        position: relative;
        width: 15vw;
        font-size: 1.78vw;
        font-weight: bold;
        color: white;
        top: 16vw;
        left: 50%;
        transform: translateX(-50%);
        user-select: none;
      }

      .selected {
        background-color: black;
        border: 2px solid #14425a;
        height: 4vw;
        line-height: 4vw;
        cursor: pointer;
        text-align: center;
        box-sizing: border-box;
        position: relative;
        padding-right: 0;
      }

      /* Removed arrow styling */

      .options {
        max-height: 0;
        opacity: 0;
        overflow: hidden;
        transition: max-height 0.3s ease, opacity 0.3s ease;
        position: absolute;
        top: 100%;
        left: 0;
        width: 100%;
        background-color: black;
        border: 2px solid #14425a;
        box-sizing: border-box;
        z-index: 10;
        pointer-events: none;
      }

      .options.show {
        max-height: 300vw; /* 4 options * 4vw */
        opacity: 1;
        pointer-events: auto;
      }

      .options div {
        height: 4vw;
        line-height: 4vw;
        border-top: 1px solid #14425a;
        cursor: pointer;
        text-align: center;
        box-sizing: border-box;
        opacity: 0;
        transform: translateY(10px);
        transition: opacity 0.3s ease, transform 0.3s ease;
      }

      .options.show div {
        opacity: 1;
        transform: translateY(0);
      }

      .options div:hover {
        background-color: #0a2c3b;
      }
    </style>
  </head>
  <body>
    <div class="header">
      <img src="/public/files/smallLogoClear.png" class="logo" />
      <div class="about">Department</div>
      <img
        src="/public/files/images__1_-removebg-preview.png"
        class="about-icon"
      />
    </div>

    <div class="container">
      <div class="database">Database</div>
      <div class="notepad">Notepad</div>
      <div class="map">Map</div>
      <div class="resources">Resources</div>
    </div>

    <div class="status">Current Status</div>

    <div class="custom-select">
      <div class="selected">Offline</div>
      <div class="options">
        <% const options = ["Available", "Busy", "Unavailable", "Offline"];
        options.forEach(function(opt, index) { %>
          
        <div
          data-value="<%= opt %>"
          style="transition-delay: <%= index * 0.1 + 0.05 %>s"
        >
          <%= opt %>
        </div>

        <% }); %>
      </div>
    </div>

    <script src="/socket.io/socket.io.js"></script>
    <script>
      const socket = io();

      socket.on("connect", () => {
        console.log("Connected to server");
      });

      const customSelect = document.querySelector(".custom-select");
      const selected = customSelect.querySelector(".selected");
      const options = customSelect.querySelector(".options");
      const optionItems = options.querySelectorAll("div");

      selected.addEventListener("click", () => {
        options.classList.toggle("show");
        selected.classList.toggle("open");
      });

      optionItems.forEach((item) => {
        item.addEventListener("click", () => {
          selected.textContent = item.textContent;
          selected.dataset.value = item.dataset.value;
          options.classList.remove("show");
          selected.classList.remove("open");
          console.log("Selected:", item.dataset.value);
          // socket.emit("statusUpdate", item.dataset.value);
        });
      });

      document.addEventListener("click", (e) => {
        if (!customSelect.contains(e.target)) {
          options.classList.remove("show");
          selected.classList.remove("open");
        }
      });
    </script>
  </body>
</html>
