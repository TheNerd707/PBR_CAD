<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>LEO</title>
    <style>
      html,
      body {
        margin: 0;
        padding: 0;
        font-family: "Verdana Pro", sans-serif;
        background-color: black;
      }

      .header {
        position: absolute;
        width: 100%;
        height: 2.25vw;
        background-color: #14425a;
      }

      .logo {
        position: absolute;
        left: 0.01vw;
        width: 2.2vw;
        top: 50%;
        transform: translateY(-50%);
      }

      .about {
        position: absolute;
        right: 1.3vw;
        font-size: 1vw;
        color: white;
        top: 50%;
        transform: translateY(-50%);
      }

      .about-icon {
        position: absolute;
        right: 0.1vw;
        width: 1.1vw;
        height: 1.1vw;
        top: 59%;
        transform: translateY(-50%);
      }

      .container {
        position: absolute;
        top: 5vw;
        width: 100%;
        display: flex;
        justify-content: center;
        gap: 1vw;
      }

      .database,
      .notepad,
      .map,
      .resources {
        width: 15vw;
        height: 4vw;
        background-color: #14425a;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2vw;
        font-weight: bold;
        cursor: pointer;
      }

      .status {
        position: absolute;
        top: 11vw;
        width: 100%;
        height: 5vw;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2vw;
        font-weight: bold;
      }

      .custom-select {
        position: relative;
        width: 15vw;
        font-size: 1.78vw;
        font-weight: bold;
        color: white;
        top: 16vw;
        left: 50%;
        transform: translateX(-50%);
        user-select: none;
        z-index: 10;
      }

      .selected {
        background-color: black;
        border: 2px solid #14425a;
        height: 4vw;
        line-height: 4vw;
        cursor: pointer;
        text-align: center;
        box-sizing: border-box;
        position: relative;
        padding-right: 0;
      }

      /* Removed arrow styling */

      .options {
        max-height: 0;
        opacity: 0;
        overflow: hidden;
        transition: max-height 0.3s ease, opacity 0.3s ease;
        position: absolute;
        top: 100%;
        left: 0;
        width: 100%;
        background-color: black;
        border: 2px solid #14425a;
        box-sizing: border-box;
        z-index: 10;
        pointer-events: none;
      }

      .options.show {
        max-height: 300vw; /* 4 options * 4vw */
        opacity: 1;
        pointer-events: auto;
        z-index: 10;
      }

      .options div {
        height: 4vw;
        line-height: 4vw;
        border-top: 1px solid #14425a;
        cursor: pointer;
        text-align: center;
        box-sizing: border-box;
        opacity: 0;
        transform: translateY(10px);
        transition: opacity 0.3s ease, transform 0.3s ease;
        z-index: 10;
      }

      .options.show div {
        z-index: 10;
        opacity: 1;
        transform: translateY(0);
      }

      .options div:hover {
        background-color: #0a2c3b;
      }
      .panic {
        position: absolute;
        top: 23vw;
        left: 50%;
        transform: translateX(-50%);
        width: 15vw;
        height: 4vw;
        background-color: red;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2vw;
        font-weight: bold;
        cursor: pointer;
        z-index: -1;
      }
      .callsheader {
        position: absolute;
        top: 30vw;
        width: 100%;
        display: flex;
        align-items: center;

        color: white;
      }
      .calls {
        font-size: 2vw;
        position: absolute;
        left: 10vw;
        font-weight: bold;
      }
      .create {
        background-color: #14425a;
        color: white;
        cursor: pointer;
        right: 10vw;
        position: absolute;
        font-size: 1.3vw;
        padding: 0.5vw 1vw;
      }
      .callContainer {
        position: absolute;
        top: 32vw;
        width: calc(1144 / 1366 * 100vw);
        height: calc(300 / 1366 * 100vw);
        left: 50%;
        transform: translateX(-50%);
        background-color: black;
        border: 2px solid #14425a;
        display: block;
        flex-direction: column;
        align-items: center;
        padding: 0.5vw;
        overflow-y: scroll;
        scrollbar-width: thin;
        scrollbar-color: #14425a black;
      }
      .callContainer::-webkit-scrollbar {
        width: 0.5vw;
      }
      .callContainer::-webkit-scrollbar-thumb {
        background-color: black;
      }
      .callContainer::-webkit-scrollbar-track {
        background-color: #14425a;
      }

      /* Call Div Styles */
      .callDiv {
        margin-bottom: 0.5vw;
        display: block;
        position: relative;
        width: 100%;
        box-sizing: border-box;
        background-color: #292929;
        color: white;
        padding: 1vw;
        box-shadow: 0 0.2vw 0.5vw rgba(0, 0, 0, 0.3);
      }
      .callTitle {
        font-size: 1.5vw;
        font-weight: bold;
      }
      .callLocation,
      .callUnits,
      .callAdditionalsNeeded {
        font-size: 1.2vw;
        margin-top: 0.4vw;
      }
      .callLine {
        height: 40%;
        width: 0.25%;
        background-color: white;
        position: absolute;
        left: 50%;
        top: 50%;
        transform: translateY(-50%);
        pointer-events: none;
        border-radius: 2px;
      }
      .callDescription {
        font-size: 1.2vw;
        position: absolute;
        left: 52%;
        top: 30%;
        width: 45.5%;
        box-sizing: border-box;
        text-align: left;
      }
      .callDelete {
        position: absolute;
        right: 0vw;
        top: 0vw;
        width: 1.75vw;
        height: 1.75vw;
        background-image: url("/public/files/x.png");
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        background-size: cover;
      }
      .callDelete.hidden {
        opacity: 0.5;
        cursor: not-allowed;
      }
      .callButtons {
        position: absolute;
        right: 0.5vw;
        bottom: 0.5vw;
        display: flex;
        gap: 1vw;
      }
      .callEdit,
      .callHold,
      .callDetach,
      .callAttach {
        background-color: #14425a;
        color: white;
        border: none;
        width: 6vw;
        cursor: pointer;
        font-size: 1vw;
        padding: 0.25vw 0;
      }
    </style>
  </head>
  <body>
    <div class="header">
      <img src="/public/files/smallLogoClear.png" class="logo" />
      <div class="about">Department</div>
      <img
        src="/public/files/images__1_-removebg-preview.png"
        class="about-icon"
      />
    </div>

    <div class="container">
      <div class="database">Database</div>
      <div class="notepad">Notepad</div>
      <div class="map">Map</div>
      <div class="resources">Resources</div>
    </div>

    <div class="status">Current Status</div>

    <div class="custom-select">
      <div class="selected">Offline</div>
      <div class="options">
        <% const options = ["Available", "Busy", "Unavailable", "Offline"];
        options.forEach(function(opt, index) { %>
        <div
          data-value="<%= opt %>"
          style="transition-delay: <%= index * 0.1 + 0.05 %>s"
        >
          <%= opt %>
        </div>
        <% }); %>
      </div>
    </div>
    <div class="panic">PANIC</div>
    <div class="callsheader">
      <div class="calls">Calls:</div>
      <div class="create">CREATE A NEW CALL</div>
    </div>
    <div class="callContainer">
      <div class="callContent"></div>
    </div>
  </body>
  <script src="/socket.io/socket.io.js"></script>
  <script>
    //socket Scripting
    const userData = {};
    const socket = io();
    socket.on("connect", () => {
      console.log("Connected to server");
      socket.emit("fetchAllCalls")
    });
    socket.on("disconnect", () => {
      console.log("Disconnected from server");
    });
    socket.on('userConnected', (user) => {
      console.log("User connected:", user);
    });
    socket.on("join", (roomName) => {
      console.log("Joined room:", roomName);
    });
    socket.on("userData", (data) => {
      userData.supervisor = data.supervisor;
    });
    socket.on("calls", (calls) => {
      const callContent = document.querySelector(".callContent"); // or .callContainer

      calls.forEach((call) => {
        const callDiv = document.createElement("div");
        callDiv.id = call.id; // Store unique ID
        callDiv.classList.add("callDiv");

        // Elements
        const title = document.createElement("div");
        title.textContent = `Call Title: ${call.title}`;
        title.classList.add("callTitle");

        const location = document.createElement("div");
        location.textContent = `Location: ${call.location}`;
        location.classList.add("callLocation");

        const units = document.createElement("div");
        units.textContent = `Assigned Units: ${call.units.join(", ")}`;
        units.classList.add("callUnits");

        const additionalsNeeded = document.createElement("div");
        additionalsNeeded.textContent = `Additionals Needed: ${call.additionalsNeeded}`;
        additionalsNeeded.classList.add("callAdditionalsNeeded");

        const line = document.createElement("div");
        line.classList.add("callLine");

        const description = document.createElement("div");
        description.textContent = `Description: ${call.description}`;
        description.classList.add("callDescription");

        const callDelete = document.createElement("div");
        callDelete.classList.add("callDelete");
        if (!userData.supervisor && call.units.length != 0) {
          callDelete.classList.add("hidden");
        }

        const buttons = document.createElement("div");
        buttons.classList.add("callButtons");

        const edit = document.createElement("button");
        edit.textContent = "EDIT";
        edit.classList.add("callEdit");

        const hold = document.createElement("button");
        hold.textContent = "HOLD";
        hold.classList.add("callHold");

        const detach = document.createElement("button");
        detach.textContent = "DETACH";
        detach.classList.add("callDetach");

        const attach = document.createElement("button");
        attach.textContent = "ATTACH";
        attach.classList.add("callAttach");

        // Append buttons
        buttons.append(edit, hold, detach, attach);

        // Compose callDiv
        callDiv.append(
          title,
          location,
          units,
          additionalsNeeded,
          line,
          description,
          callDelete,
          buttons
        );

        callDiv.id = call.id; // Set the ID for easy reference
        // Append to container
        callContent.appendChild(callDiv);
      });
    });

    socket.on("callUpdate", (call) => {
      const callContent = document.querySelector(".callContent");
      const existingCall = callContent.querySelector(`.${call.id}`);
      if (existingCall) {
        existingCall.textContent = `Call ID: ${call.id}, Description: ${call.description}`;
      }
    });
  </script>
  <script>
    //Call buttons
    const callContent = document.querySelector(".callContent");
    callContent.addEventListener("click", (e) => {
      if (e.target.classList.contains("callDelete") ) {
        if (e.target.classList.contains("hidden")) {
          console.log("You cannot delete this call");
          return;
        }
        const callDiv = e.target.closest(".callDiv");
        const callId = callDiv.id; // Get the ID of the call
        console.log("Delete button clicked for call ID:", callId);
        fetch(`/leo/calls/${callId}`, {
          method: "DELETE"
        })
        .then(response => {
          if (response.ok) {
            console.log("Call deleted successfully");
            callDiv.remove(); // Remove the callDiv from the DOM
          } else {
            console.error("Failed to delete call");
          }
        })
      }
    })
  </script>
  <script>
    //status
    const customSelect = document.querySelector(".custom-select");
    const selected = customSelect.querySelector(".selected");
    const options = customSelect.querySelector(".options");
    const optionItems = options.querySelectorAll("div");

    selected.addEventListener("click", () => {
      options.classList.toggle("show");
      selected.classList.toggle("open");
    });

    optionItems.forEach((item) => {
      item.addEventListener("click", () => {
        selected.textContent = item.textContent;
        selected.dataset.value = item.dataset.value;
        options.classList.remove("show");
        selected.classList.remove("open");
        console.log("Selected:", item.dataset.value);
        // socket.emit("statusUpdate", item.dataset.value);
      });
    });

    document.addEventListener("click", (e) => {
      if (!customSelect.contains(e.target)) {
        options.classList.remove("show");
        selected.classList.remove("open");
      }
    });
  </script>
  <script>
    //button shit
    const createButton = document.querySelector(".create");
    createButton.addEventListener("click", () => {
      console.log("Create button clicked");
       fetch("/leo/calls", {
        method: "POST"
      })
    })
  </script>
  <script>
    //Phone Import
    fetch("/dev")
      .then(response => response.text())
      .then(phoneHtml => {
        // Create a container for the HTML
        const phoneDiv = document.createElement("div");
        phoneDiv.innerHTML = phoneHtml;
        document.body.appendChild(phoneDiv);

        // Extract and execute scripts
        const scripts = phoneDiv.querySelectorAll("script");
        scripts.forEach(script => {
          const newScript = document.createElement("script");
          if (script.src) {
            newScript.src = script.src;
          } else {
            newScript.textContent = script.textContent;
          }
          document.body.appendChild(newScript);
        });

        // Extract and apply styles
        const styles = phoneDiv.querySelectorAll("style, link[rel='stylesheet']");
        styles.forEach(style => {
          if (style.tagName.toLowerCase() === "style") {
            const newStyle = document.createElement("style");
            newStyle.textContent = style.textContent;
            document.head.appendChild(newStyle);
          } else if (style.tagName.toLowerCase() === "link") {
            const newLink = document.createElement("link");
            Array.from(style.attributes).forEach(attr => {
              newLink.setAttribute(attr.name, attr.value);
            });
            document.head.appendChild(newLink);
          }
        });
      });
  </script>
</html>
