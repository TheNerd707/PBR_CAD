<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Civilian Pannel</title>
  </head>
  <body>
    <div class="pbr">PROJECT BLACK ROSE</div>
    <div class="simple">IN CONJUNCTION WITH SIMPLE WAY</div>
    <div class="header">
      <img src="public/files/PBR_WHITE_NO_TXT.png" class="logo" />
      <div class="civRes">CIVILIAN RESOURCES</div>
      <div class="complaint">FILE A COMPLAINT</div>
      <% const user = {ccs: true} %> <% if (user.ccs) {%>
      <a href="/ccs" class="ccs">CCS MENU</a>
      <% } %>
    </div>

    <div class="characterHead">
      <div class="lineh"></div>
      <div class="linev1"></div>
      <div class="name">NAME</div>
      <div class="linev2"></div>
      <div class="dln">DRIVERS LIC #</div>
      <div class="linev3"></div>
      <div class="dob">DOB</div>
      <div class="linev4"></div>
      <div class="occupation">OCCUPATION</div>
      <div class="linev5"></div>
      <div class="status">STATUS</div>
      <div class="linev6"></div>
      <div class="lineh2"></div>
    </div>
    <div class="footer">
      <div class="logoFoot"></div>
      <div class="dir">DIRECTED BY "s403xray" & "the_nerd1"</div>
      <div class="trademark">
        TRADEMARKED 2024 PROJECT BLACK ROSE. ALL RIGHTS RESERVED
      </div>
    </div>
  </body>
  <style>
    html {
      scroll-behavior: smooth;
      scrollbar-width: none;
    }
    body {
      font-family: "Proxima Nova";
      background-color: black;
      color: white;
      margin: 0;
      padding: 0;
      height: 200vh;
    }
    .header {
      height: 3vw;
      display: flex;
      padding: 10px;
      margin: none;
      background-color: #333;
      align-items: center;
    }
    .logo {
      margin-left: -2vw;
      height: 4vw;
    }
    .civRes {
      height: 2.5vw;
      width: 18vw;
      background-color: black;
      margin-left: -1vw;
      font-size: 1.5vw;
      text-align: center;
      align-content: center;
      border-color: white;
      border-style: solid;
      border-width: 0.1vw;
    }
    .complaint {
      height: 2.5vw;
      width: 15vw;
      background-color: black;
      margin-left: 1vw;
      font-size: 1.5vw;
      text-align: center;
      align-content: center;
      border-color: white;
      border-style: solid;
      border-width: 0.1vw;
    }
    .ccs {
      color: inherit;
      text-decoration: none;
      height: 2.5vw;
      width: 10vw;
      background-color: black;
      margin-left: 1vw;
      font-size: 1.5vw;
      text-align: center;
      align-content: center;
      border-color: white;
      border-style: solid;
      border-width: 0.1vw;
    }
    .pbr {
      width: 20vw;
      text-align: right;
      font-size: 1.8vw;
      margin-top: 0.5vw;
      position: absolute;
      margin-left: 80vw;
    }
    .simple {
      color: black;
      width: 30vw;
      text-align: right;
      margin-top: 2.5vw;
      font-size: 1.2vw;
      margin-left: 0vw;
      position: absolute;
      margin-left: 70vw;
    }
  </style>
</html>
